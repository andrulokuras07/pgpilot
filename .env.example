# Conexión a AppDB (BD del cliente que PgPilot analiza)
# Defaults coinciden con docker-compose.yml.
APPDB_HOST=localhost
APPDB_PORT=5434
APPDB_DB=appdb
APPDB_USER=app_user
APPDB_PASSWORD=app_pass

# Conexión al sandbox Postgres efímero (BD propia de PgPilot, no del cliente).
# Se usa para montar schemas temporales con stats falseadas y correr EXPLAIN.
# Defaults coinciden con docker-compose.yml.
SANDBOX_HOST=localhost
SANDBOX_PORT=5435
SANDBOX_DB=sandbox
SANDBOX_USER=sandbox_user
SANDBOX_PASSWORD=sandbox_pass
